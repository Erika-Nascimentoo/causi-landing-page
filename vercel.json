{
    "cleanUrls": true,
    "framework": "vite",
    "rewrites": [
        {
            "source": "/advogado/solucoes/(.*)",
            "destination": "/$1"
        },
        {
            "source": "/(.*)/assets/(.*)",
            "destination": "/assets/$2"
        },
        {
            "source": "/estruturacao-estrategica",
            "destination": "/estruturacao-estrategica/index.html"
        },
        {
            "source": "/estruturacao-estrategica/(.*)",
            "destination": "/estruturacao-estrategica/index.html"
        },
        {
            "source": "/programa-de-aceleracao-juridica",
            "destination": "/programa-de-aceleracao-juridica/index.html"
        },
        {
            "source": "/programa-de-aceleracao-juridica/(.*)",
            "destination": "/programa-de-aceleracao-juridica/index.html"
        },
        {
            "source": "/programa-de-aceleracao-juridica/criar-conta",
            "destination": "/programa-de-aceleracao-juridica/criar-conta/index.html"
        },
        {
            "source": "/programa-de-aceleracao-juridica/criar-conta/(.*)",
            "destination": "/programa-de-aceleracao-juridica/criar-conta/index.html"
        }
    ]
}